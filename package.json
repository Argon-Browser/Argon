{
  "name": "argon-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Argon Browser: an independent desktop browser forked from Firefox (Gecko), with an Arc-inspired interface and a Chromium extension compatibility bridge.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "python3 scripts/dev-browser.py",
    "dev:sync": "python3 scripts/dev-browser.py --sync-only",
    "dev:reset": "python3 scripts/dev-browser.py --reset-profile",
    "reset": "python3 scripts/dev-browser.py --reset-profile --sync-only",
    "run:reset": "python3 scripts/dev-browser.py --reset-profile",
    "test:dev": "python3 -m unittest discover -s tests/dev -q",
    "test": "node scripts/run-unit-tests.mjs",
    "build:adblock": "python3 scripts/build-native-adblock.py",
    "test:adblock": "node --test tests/adblock/*.test.mjs && python3 tests/adblock/test_native.py",
    "update:adblock": "python3 scripts/update-native-adblock-lists.py",
    "test:appearance": "node --test tests/appearance/*.test.mjs",
    "test:onboarding": "node --test tests/onboarding/*.test.mjs",
    "test:extensions": "node --test tests/extensions/*.test.mjs",
    "test:website": "node --test tests/website/*.test.mjs",
    "test:build": "python3 -m unittest discover -s tests/build -q",
    "test:branding": "python3 -m unittest discover -s tests/branding -q",
    "test:python": "npm run test:build && npm run test:branding",
    "analyze": "node argon/extensions/analyze-cli.mjs",
    "site": "node scripts/serve-website.mjs",
    "doctor": "python3 scripts/argon.py doctor",
    "fetch": "python3 scripts/argon.py fetch",
    "apply": "python3 scripts/argon.py apply",
    "bootstrap": "python3 scripts/argon.py bootstrap",
    "build": "python3 scripts/argon.py build",
    "build:artifact": "python3 scripts/argon.py --artifact build",
    "start": "python3 scripts/argon.py run",
    "package": "python3 scripts/argon.py package",
    "flatpak": "python3 scripts/argon.py flatpak",
    "test:ghostprint": "node --test tests/adblock/ghostprint.test.mjs third_party/ghostprint/tests/*.test.js",
    "test:browser:ghostprint": "node scripts/run-browser-tests.mjs --ghostprint",
    "test:browser:adblock": "node scripts/run-browser-tests.mjs --adblock",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "diagnose:browser": "node scripts/run-browser-tests.mjs --diagnose"
  },
  "keywords": [
    "browser",
    "firefox",
    "gecko",
    "webextensions",
    "argon"
  ]
}
