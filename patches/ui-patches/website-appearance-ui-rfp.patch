Disable the website appearance setting when RFP is disabled and add an info why
---
diff --git a/browser/components/preferences/config/appearance.mjs b/browser/components/preferences/config/appearance.mjs
index 5cd14dd11e..6a6b27bc4a 100644
--- a/browser/components/preferences/config/appearance.mjs
+++ b/browser/components/preferences/config/appearance.mjs
@@ -276,6 +276,48 @@ if (Services.prefs.getBoolPref("browser.settings-redesign.enabled", false)) {
   });
 }
 
+const syncWebAppearanceChooserState = (() => {
+  let pendingDisabled = false;
+  let chooserObserver = null;
+  let unloadBound = false;
+  const applyState = () => {
+    const chooser = document.getElementById("web-appearance-chooser");
+    if (!chooser) return false;
+    chooser.style.opacity = pendingDisabled ? "0.3" : "1";
+    chooser.style.pointerEvents = pendingDisabled ? "none" : "all";
+    chooserObserver?.disconnect();
+    chooserObserver = null;
+    return true;
+  };
+  const cleanup = () => {
+    chooserObserver?.disconnect();
+    chooserObserver = null;
+  };
+  return disabled => {
+    pendingDisabled = Boolean(disabled);
+    if (applyState()) return;
+    if (!chooserObserver && typeof MutationObserver === "function" && document.documentElement) {
+      chooserObserver = new MutationObserver(() => {
+        applyState();
+      });
+      chooserObserver.observe(document.documentElement, { childList: true, subtree: true });
+      if (!unloadBound && typeof window !== "undefined") {
+        unloadBound = true;
+        window.addEventListener("unload", cleanup, { once: true });
+      }
+    }
+  };
+})();
+
+Preferences.addSetting({
+  id: "librewolfRFPWarning",
+  deps: ["librewolfRFP"],
+  visible: ({librewolfRFP}) => {
+    syncWebAppearanceChooserState(librewolfRFP.value);
+    return librewolfRFP.value;
+  },
+});
+
 SettingGroupManager.registerGroups({
   appearance: {
     l10nId: "appearance-group2",
