    {
      "path": "browser/components/preferences/preferences.js",
      "resource": "chrome/browser/content/browser/preferences/preferences.js",
      "comment_prefix": "//",
      "replacements": [
        {
          "old": "function init_all() {\n  Preferences.forceEnableInstantApply();",
          "new": "async function init_all() {\n  // Argon owns the settings shell; native controllers still own every preference.\n  const { initializeArgonPreferences } = await import(\"chrome://browser/content/argon/settings-native.mjs\");\n  await initializeArgonPreferences(document, window);\n  Preferences.forceEnableInstantApply();"
        },
        {
          "old": "    visible: () => NimbusFeatures.moreFromMozilla.getVariable(\"enabled\"),",
          "new": "    // Argon: remove the \"More from Mozilla/Argon\" pane completely.\n    visible: () => false,"
        },
        {
          "old": "  } else {\n    NimbusFeatures.moreFromMozilla.recordExposureEvent({ once: true });\n    if (NimbusFeatures.moreFromMozilla.getVariable(\"enabled\")) {\n      document.getElementById(\"category-more-from-mozilla\").hidden = false;\n      gMoreFromMozillaPane.option =\n        NimbusFeatures.moreFromMozilla.getVariable(\"template\");\n      register_module(\"paneMoreFromMozilla\", gMoreFromMozillaPane);\n    }\n  }",
          "new": "  } else {\n    // Argon: \"More from Mozilla/Argon\" removed completely.\n  }"
        }
      ],
      "note": "Initialize the Argon layout and extra panes before native routing and search. Keep the native about:preferences principal, controllers, feature gates and dialogs."
    },
