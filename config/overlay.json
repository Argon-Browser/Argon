    },
    {
      "from": "argon/extensions/compatibility-adapter.mjs",
      "to": "browser/base/content/argon/compatibility-adapter.mjs"
    },
    {
      "from": "argon/extensions/extension-installer.mjs",
      "to": "browser/base/content/argon/extension-installer.mjs"
    }
  ],
  "branding": {
    "from": "browser/branding/argon",
    "to": "browser/branding/argon",
    "note": "Copied read-only into the upstream checkout so that --with-branding=browser/branding/argon resolves inside the source tree. The repository files themselves belong to the branding track."
  },
  "hooks": [
    {
      "path": "browser/base/jar.mn",
      "comment_prefix": "#",
      "insert_before": "# L10n resources and overrides.",
      "entry_template": "        {destination:<51} ({source})",
      "entries": [
        {
          "destination": "content/browser/argon/tokens.css",
          "source": "content/argon/tokens.css"
        },
        {
          "destination": "content/browser/argon/argon.css",
          "source": "content/argon/argon.css"
        },
        {
          "destination": "content/browser/argon/argon-controller.mjs",
          "source": "content/argon/argon-controller.mjs"
        },
