          "source": "content/argon/workspaces.mjs"
        },
        {
          "destination": "content/browser/argon/command-palette.mjs",
          "source": "content/argon/command-palette.mjs"
        },
        {
          "destination": "content/browser/argon/settings.html",
          "source": "content/argon/settings.html"
        },
        {
          "destination": "content/browser/argon/settings.css",
          "source": "content/argon/settings.css"
        },
        {
          "destination": "content/browser/argon/settings.mjs",
          "source": "content/argon/settings.mjs"
        },
        {
          "destination": "content/browser/argon/json-safety.mjs",
          "source": "content/argon/json-safety.mjs"
        },
        {
          "destination": "content/browser/argon/permissions.mjs",
          "source": "content/argon/permissions.mjs"
        },
        {
          "destination": "content/browser/argon/manifest-rules.mjs",
          "source": "content/argon/manifest-rules.mjs"
        },
        {
          "destination": "content/browser/argon/manifest-analyzer.mjs",
          "source": "content/argon/manifest-analyzer.mjs"
        },
        {
          "destination": "content/browser/argon/background-runtime.mjs",
          "source": "content/argon/background-runtime.mjs"
        },
        {
          "destination": "content/browser/argon/compatibility-adapter.mjs",
          "source": "content/argon/compatibility-adapter.mjs"
        },
        {
          "destination": "content/browser/argon/extension-installer.mjs",
          "source": "content/argon/extension-installer.mjs"
        }
      ]
    },
    {
      "path": "browser/app/profile/firefox.js",
      "comment_prefix": "//",
      "insert_at_end": true,
      "include": "argon/preferences/argon-prefs.js"
    },
    {
      "path": "browser/extensions/newtab/lib/AboutPreferences.sys.mjs",
      "resource": "chrome/browser/builtin-addons/newtab/lib/AboutPreferences.sys.mjs",
      "comment_prefix": "//",
      "replacements": [
        {
          "old": "    Preferences.addSetting({\n      id: \"sponsoredShortcuts\",\n      pref: \"browser.newtabpage.activity-stream.showSponsoredTopSites\",\n      deps: [\"topsitesEnabled\"],\n      disabled: ({ topsitesEnabled }) => !topsitesEnabled.value,\n    });",
          "new": "    Preferences.addSetting({\n      id: \"sponsoredShortcuts\",\n      // Argon: sponsored shortcuts are removed from the New Tab page. Keep the\n      // setting registered so the remaining preferences keep their shape, but\n      // never render it.\n      visible: () => false,\n      pref: \"browser.newtabpage.activity-stream.showSponsoredTopSites\",\n      deps: [\"topsitesEnabled\"],\n      disabled: ({ topsitesEnabled }) => !topsitesEnabled.value,\n    });"
        },
        {
          "old": "    Preferences.addSetting({\n      id: \"supportFirefox\",\n      pref: \"browser.newtabpage.activity-stream.showSponsoredCheckboxes\",\n      deps: [\"sponsoredShortcuts\", \"sponsoredStories\", ...firefoxHomeDeps],\n      disabled: deps => !firefoxHomeActive(deps),\n      onUserChange(value, { sponsoredShortcuts, sponsoredStories }) {\n        // When supportFirefox changes, automatically update child preferences to match\n        sponsoredShortcuts.value = !!value;\n        sponsoredStories.value = !!value;\n      },\n    });",
          "new": "    Preferences.addSetting({\n      id: \"supportFirefox\",\n      pref: \"browser.newtabpage.activity-stream.showSponsoredCheckboxes\",\n      deps: [\"sponsoredStories\", ...firefoxHomeDeps],\n      disabled: deps => !firefoxHomeActive(deps),\n      onUserChange(value, { sponsoredStories }) {\n        // When supportFirefox changes, automatically update child preferences to match.\n        // Argon: sponsored shortcuts are removed, so the master toggle only\n        // controls sponsored stories.\n        sponsoredStories.value = !!value;\n      },\n    });"
        },
        {
          "old": "            {\n              id: \"sponsoredShortcuts\",\n              l10nId: \"home-prefs-shortcuts-by-option-sponsored-srd\",\n            },",
          "new": "            // Argon: the sponsored shortcuts control is removed."
        }
      ],
      "note": "The New Tab settings pane must not expose a control that re-enables sponsored shortcuts. The pref defaults are disabled separately in argon/preferences/argon-prefs.js."
    },
    {
      "path": "browser/base/content/browser.xhtml",
      "comment_prefix": "<!--",
      "comment_suffix": "-->",
      "insert_after": "  <script src=\"chrome://browser/content/browser-main.js\"></script>",
      "include": "browser/base/content/argon-window-hooks.inc.xhtml"
    },
    {
      "path": "browser/moz.configure",
      "comment_prefix": "#",
      "replace_line": "imply_option(\"MOZ_APP_VENDOR\", \"Mozilla\")",
      "lines": [
        "imply_option(\"MOZ_APP_VENDOR\", \"Argon\")",
        "imply_option(\"MOZ_APP_PROFILE\", \"argon\")"
      ],
      "note": "Application vendor and profile directory (application.ini Vendor and Profile fields). Both are project_flag() options upstream with possible_origins=('implied',), so they must be set via imply_option() rather than the mozconfig."
    }
  ]
}
