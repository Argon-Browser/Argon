    },
    {
      "from": "argon/preferences/settings.html",
      "to": "browser/base/content/argon/settings.html"
    },
    {
      "from": "argon/preferences/settings.css",
      "to": "browser/base/content/argon/settings.css"
    },
    {
      "from": "argon/preferences/settings.mjs",
      "to": "browser/base/content/argon/settings.mjs"
